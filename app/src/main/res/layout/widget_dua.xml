<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_bg"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_vertical">
    <TextView android:id="@+id/w_label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/widget_green" android:textSize="10sp" android:text="DUA OF THE DAY" />
    <TextView android:id="@+id/w_arabic" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/widget_text" android:textSize="17sp" android:textAlignment="viewEnd"
        android:textDirection="rtl" android:layout_marginTop="8dp" android:lineSpacingMultiplier="1.3"
        android:text="رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً" />
    <TextView android:id="@+id/w_translation" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/widget_text_sec" android:textSize="12sp" android:layout_marginTop="8dp"
        android:maxLines="3" android:text="Our Lord, give us good in this world and the Hereafter." />
    <TextView android:id="@+id/w_ref" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/widget_green" android:textSize="10sp" android:layout_marginTop="6dp"
        android:text="Qur'an 2:201" />
</LinearLayout>
