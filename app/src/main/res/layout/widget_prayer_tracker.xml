<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_bg"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_vertical">
    <TextView android:id="@+id/w_label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/widget_green" android:textSize="10sp" android:text="TODAY'S PRAYERS" />
    <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/widget_text" android:textSize="26sp" android:textStyle="bold"
        android:text="0 / 5" android:layout_marginTop="2dp" />
    <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/widget_text_sec" android:textSize="11sp" android:text="—" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="12dp" android:gravity="center">
        <TextView android:id="@+id/dot_fajr" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="center" android:textColor="@color/widget_green" android:textSize="18sp" android:text="○" />
        <TextView android:id="@+id/dot_dhuhr" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="center" android:textColor="@color/widget_green" android:textSize="18sp" android:text="○" />
        <TextView android:id="@+id/dot_asr" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="center" android:textColor="@color/widget_green" android:textSize="18sp" android:text="○" />
        <TextView android:id="@+id/dot_maghrib" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="center" android:textColor="@color/widget_green" android:textSize="18sp" android:text="○" />
        <TextView android:id="@+id/dot_isha" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="center" android:textColor="@color/widget_green" android:textSize="18sp" android:text="○" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="2dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="center" android:textColor="@color/widget_text_sec" android:textSize="9sp" android:text="Fajr" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="center" android:textColor="@color/widget_text_sec" android:textSize="9sp" android:text="Dhuhr" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="center" android:textColor="@color/widget_text_sec" android:textSize="9sp" android:text="Asr" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="center" android:textColor="@color/widget_text_sec" android:textSize="9sp" android:text="Maghrib" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="center" android:textColor="@color/widget_text_sec" android:textSize="9sp" android:text="Isha" />
    </LinearLayout>
</LinearLayout>
