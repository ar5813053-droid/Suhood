<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/w_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="@color/widget_green" android:textSize="10sp" android:text="PRAYER MARKER" />
        <TextView android:id="@+id/w_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/widget_text" android:textSize="12sp" android:textStyle="bold" android:text="0/5" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row_fajr" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="8dp" android:layout_marginTop="6dp"
        android:background="@color/widget_surface">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="@color/widget_text" android:textSize="13sp" android:text="Fajr" />
        <TextView android:id="@+id/st_fajr" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/widget_text_sec" android:textSize="11sp" android:text="Mark" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row_dhuhr" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="8dp" android:layout_marginTop="4dp"
        android:background="@color/widget_surface">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="@color/widget_text" android:textSize="13sp" android:text="Dhuhr" />
        <TextView android:id="@+id/st_dhuhr" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/widget_text_sec" android:textSize="11sp" android:text="Mark" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row_asr" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="8dp" android:layout_marginTop="4dp"
        android:background="@color/widget_surface">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="@color/widget_text" android:textSize="13sp" android:text="Asr" />
        <TextView android:id="@+id/st_asr" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/widget_text_sec" android:textSize="11sp" android:text="Mark" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row_maghrib" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="8dp" android:layout_marginTop="4dp"
        android:background="@color/widget_surface">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="@color/widget_text" android:textSize="13sp" android:text="Maghrib" />
        <TextView android:id="@+id/st_maghrib" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/widget_text_sec" android:textSize="11sp" android:text="Mark" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row_isha" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="8dp" android:layout_marginTop="4dp"
        android:background="@color/widget_surface">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="@color/widget_text" android:textSize="13sp" android:text="Isha" />
        <TextView android:id="@+id/st_isha" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/widget_text_sec" android:textSize="11sp" android:text="Mark" />
    </LinearLayout>
</LinearLayout>
