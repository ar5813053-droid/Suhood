<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_bg"
    android:orientation="vertical"
    android:padding="14dp"
    android:gravity="center">
    <TextView android:id="@+id/w_weekday" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/widget_text" android:textSize="20sp" android:textStyle="bold"
        android:textDirection="rtl" android:text="—" />
    <TextView android:id="@+id/w_day" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/widget_text" android:textSize="44sp" android:textStyle="bold"
        android:text="—" android:layout_marginTop="4dp" />
    <TextView android:id="@+id/w_month" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/widget_text_sec" android:textSize="11sp" android:letterSpacing="0.08"
        android:text="—" />
    <TextView android:id="@+id/w_hijri_ar" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/widget_silver" android:textSize="14sp" android:textDirection="rtl"
        android:layout_marginTop="8dp" android:text="—" />
    <TextView android:id="@+id/w_hijri_en" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/widget_text_sec" android:textSize="10sp" android:text="—" />
</LinearLayout>
